{
  "name": "daily-challenge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Daily Challenge: one thought-provoking challenge every day, shared by everyone.",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --experimental-strip-types server/dev-server.ts",
    "dev:local": "node --experimental-strip-types scripts/dev-local.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "seed:build": "node --experimental-strip-types scripts/build-seed.ts",
    "db:reset": "node --experimental-strip-types scripts/db-reset.ts",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "node --experimental-strip-types tests/e2e/journey.test.ts",
    "standard:build": "node --experimental-strip-types scripts/build-standard.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
