{
  "manifest_version": 3,
  "name": "Aim",
  "version": "0.39.0",
  "minimum_chrome_version": "116",
  "key": "",
  "description": "Study on YouTube without getting distracted. Your search becomes your Target, and Aim helps you stay focused on it.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/early.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/core.js",
        "content/youtube.js",
        "content/ui.js",
        "content/gate.js",
        "content/channels.js",
        "content/focus.js",
        "content/session.js",
        "content/home.js",
        "content/search.js",
        "content/librarian.js",
        "content/filetext.js",
        "content/study.js",
        "content/plan.js",
        "content/pathways.js",
        "content/video.js",
        "content/relax.js",
        "content/notes.js",
        "content/onboarding.js",
        "content/upnext.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aim",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "signin.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "fonts/InterDisplay-Bold.woff2"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ]
    }
  ]
}
